# OpenAI API Key for chatbot
OPENAI_API_KEY=your_openai_api_key_here

# Resend API Key for email notifications
RESEND_API_KEY=your_resend_api_key_here

# ---- Reservas propias (ver RESERVAS.md) ----
# Base de datos Postgres (Neon). Sin ella, en local se usa .data/pglite
DATABASE_URL=
# TPV: addon (Addon Payments de Comercia), redsys o, solo en local/pruebas, simulado
PAGOS_PROVEEDOR=simulado
ADDON_COMERCIO=
ADDON_CUENTA=internet
ADDON_SECRETO=
ADDON_ENTORNO=pruebas
REDSYS_COMERCIO=
REDSYS_TERMINAL=1
REDSYS_CLAVE=
REDSYS_ENTORNO=pruebas
REDSYS_METODOS=
# Panel /admin
ADMIN_PASSWORD=
SESSION_SECRET=
# Recordatorio diario (Vercel Cron) y calendario para Google Calendar
CRON_SECRET=
CALENDARIO_TOKEN=
SITIO_URL=https://www.studioar.es
# Opcionales
RESERVAS_EMAIL_FROM=AR Studio <reservas@studioar.es>
RESERVAS_EMAIL_ESTUDIO=arstudiospain@gmail.com
# Opcional: IBAN del estudio para el recordatorio de cuota por WhatsApp
ESTUDIO_IBAN=
# 1 = los botones RESERVAR van a /reservar en vez de a Calendly
NEXT_PUBLIC_RESERVAS_PROPIAS=
# Facturas (los datos de quien factura NO van en el código: el repositorio es público)
FACTURA_EMISOR_NOMBRE=
FACTURA_EMISOR_NIF=
FACTURA_EMISOR_DIRECCION=
FACTURA_SERIE=AR-W
FACTURAS_AUTOMATICAS=
